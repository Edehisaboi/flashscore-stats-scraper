{
  "title": "Flashscore Match Stats Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "What this run does. Each mode reads its own section below and ignores the others.\n\n**season_stats** — a whole season of finished matches with statistics, for backfill. Reads *Season backfill*.\n**fixtures** — upcoming matches, metadata only. Reads *Upcoming fixtures*.\n**fetch_stats** — statistics for specific matches you already have ids for. Reads *Match statistics*.",
      "editor": "select",
      "default": "season_stats",
      "enum": [
        "season_stats",
        "fixtures",
        "fetch_stats"
      ],
      "enumTitles": [
        "Season backfill (competition + year)",
        "Upcoming fixtures (metadata only)",
        "Match statistics (by match id)"
      ],
      "sectionCaption": "Mode",
      "sectionDescription": "Pick what this run should do, then fill in only that mode's section."
    },
    "competitions": {
      "title": "Competitions",
      "type": "array",
      "description": "Competitions to scrape upcoming fixtures for. Use \"all\" for every supported competition.",
      "editor": "select",
      "default": [
        "premier_league"
      ],
      "items": {
        "type": "string",
        "enum": [
          "all",
          "premier_league",
          "fa_cup",
          "efl_cup",
          "community_shield",
          "ligue_1",
          "coupe_de_france",
          "trophee_des_champions",
          "bundesliga",
          "dfb_pokal",
          "franz_beckenbauer_supercup",
          "serie_a",
          "coppa_italia",
          "supercoppa_italiana",
          "la_liga",
          "copa_del_rey",
          "supercopa_de_espana",
          "champions_league",
          "europa_league",
          "conference_league",
          "uefa_super_cup",
          "fifa_intercontinental_cup",
          "fifa_club_world_cup",
          "championship",
          "eredivisie",
          "liga_portugal",
          "super_lig",
          "jupiler_pro_league",
          "scottish_premiership",
          "bundesliga_2",
          "serie_b",
          "ligue_2",
          "laliga2"
        ],
        "enumTitles": [
          "All supported competitions",
          "Premier League",
          "FA Cup",
          "EFL Cup",
          "Community Shield",
          "Ligue 1",
          "Coupe de France",
          "Trophee des Champions",
          "Bundesliga",
          "DFB-Pokal",
          "Franz Beckenbauer Supercup",
          "Serie A",
          "Coppa Italia",
          "Supercoppa Italiana",
          "La Liga",
          "Copa del Rey",
          "Supercopa de Espana",
          "UEFA Champions League",
          "UEFA Europa League",
          "UEFA Conference League",
          "UEFA Super Cup",
          "FIFA Intercontinental Cup",
          "FIFA Club World Cup",
          "Championship",
          "Eredivisie",
          "Liga Portugal",
          "Super Lig",
          "Jupiler Pro League",
          "Scottish Premiership",
          "2. Bundesliga",
          "Serie B",
          "Ligue 2",
          "LaLiga 2"
        ]
      },
      "uniqueItems": true,
      "sectionCaption": "Upcoming fixtures",
      "sectionDescription": "Used by the fixtures mode only."
    },
    "windowDays": {
      "title": "Window (days)",
      "type": "integer",
      "description": "How many days ahead to include upcoming fixtures.",
      "default": 7,
      "minimum": 1,
      "maximum": 30
    },
    "matchIds": {
      "title": "Match IDs",
      "type": "array",
      "description": "Flashscore match ids to fetch statistics for, e.g. `Ug3NfA9d`. These are the `match_id` values from a previous fixtures run. Season resolution and match enumeration are skipped entirely, so this is the cheap way to grade a known set of matches.",
      "editor": "stringList",
      "prefill": [],
      "uniqueItems": true,
      "sectionCaption": "Match statistics",
      "sectionDescription": "Used by the fetch_stats mode only."
    },
    "jobs": {
      "title": "Jobs",
      "type": "array",
      "description": "Competition/year pairs to back-fill. When set, this takes precedence over the single Competition and Year fields below. For season competitions the year is the start year, so 2024 means 2024/2025.",
      "editor": "json",
      "sectionCaption": "Season backfill",
      "sectionDescription": "Used by the season_stats mode only. Set either Jobs, or the single Competition and Year pair.",
      "items": {
        "type": "object",
        "required": [
          "competition",
          "year"
        ],
        "properties": {
          "competition": {
            "title": "Competition",
            "description": "Competition key to scrape.",
            "type": "string",
            "enum": [
              "premier_league",
              "fa_cup",
              "efl_cup",
              "community_shield",
              "ligue_1",
              "coupe_de_france",
              "trophee_des_champions",
              "bundesliga",
              "dfb_pokal",
              "franz_beckenbauer_supercup",
              "serie_a",
              "coppa_italia",
              "supercoppa_italiana",
              "la_liga",
              "copa_del_rey",
              "supercopa_de_espana",
              "champions_league",
              "europa_league",
              "conference_league",
              "uefa_super_cup",
              "fifa_intercontinental_cup",
              "fifa_club_world_cup",
              "championship",
              "eredivisie",
              "liga_portugal",
              "super_lig",
              "jupiler_pro_league",
              "scottish_premiership",
              "bundesliga_2",
              "serie_b",
              "ligue_2",
              "laliga2"
            ],
            "enumTitles": [
              "Premier League",
              "FA Cup",
              "EFL Cup",
              "Community Shield",
              "Ligue 1",
              "Coupe de France",
              "Trophee des Champions",
              "Bundesliga",
              "DFB-Pokal",
              "Franz Beckenbauer Supercup",
              "Serie A",
              "Coppa Italia",
              "Supercoppa Italiana",
              "La Liga",
              "Copa del Rey",
              "Supercopa de Espana",
              "UEFA Champions League",
              "UEFA Europa League",
              "UEFA Conference League",
              "UEFA Super Cup",
              "FIFA Intercontinental Cup",
              "FIFA Club World Cup",
              "Championship",
              "Eredivisie",
              "Liga Portugal",
              "Super Lig",
              "Jupiler Pro League",
              "Scottish Premiership",
              "2. Bundesliga",
              "Serie B",
              "Ligue 2",
              "LaLiga 2"
            ]
          },
          "year": {
            "title": "Year",
            "description": "Season start year for season competitions, or edition year for calendar competitions.",
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          }
        }
      }
    },
    "competition": {
      "title": "Competition",
      "type": "string",
      "description": "Convenience selector for a single-season run. Ignored when Jobs is set.",
      "editor": "select",
      "default": "premier_league",
      "enum": [
        "premier_league",
        "fa_cup",
        "efl_cup",
        "community_shield",
        "ligue_1",
        "coupe_de_france",
        "trophee_des_champions",
        "bundesliga",
        "dfb_pokal",
        "franz_beckenbauer_supercup",
        "serie_a",
        "coppa_italia",
        "supercoppa_italiana",
        "la_liga",
